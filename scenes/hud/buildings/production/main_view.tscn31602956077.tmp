[sub_resource type="GDScript" id="GDScript_1tidf"]
script/source = "extends Control

var recipe_packed: PackedScene = preload(\"res://scenes/hud/buildings/production/recipe.tscn\")

@onready var recipes_list: VBoxContainer = $RecipesScroll/RecipesList

var selected_recipe_scene: Node
var recipes: Array[MyResource]

func init_scene(_recipes: Array[MyResource] = []):
	recipes = _recipes

func _ready():
	_populate_recipes(recipes)

func _populate_recipes(_recipes: Array):
	for child in recipes_list.get_children():
		child.queue_free()
	for i in range(_recipes.size()):
		var recipe_scene: Node = recipe_packed.instantiate()
		recipe_scene.init_scene(
			_recipes[i].title,
			_recipes[i].desc,
			_recipes[i].icon,
			i == 0
		)
		if i == 0: selected_recipe_scene = recipe_scene
		recipe_scene.gui_input.connect(_toggle_selected_recipe.bind(recipe_scene))
		recipes_list.add_child(recipe_scene)
	
func _toggle_selected_recipe(event, scene: Node):
	if Events.isMouseLeftClick(event):
		selected_recipe_scene.set_selected(false)
		selected_recipe_scene = scene
		selected_recipe_scene.set_selected(true)
"

